# Copie este arquivo para .env e preencha com os seus valores.
# O .env nao e versionado, porque guarda a configuracao da sua maquina.

# Outlook / Microsoft Graph, via MSAL. Somente leitura.
# O tenant "consumers" limita o login a contas pessoais Microsoft.
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=consumers

# URI de redirecionamento do OAuth. Precisa estar cadastrada no
# aplicativo do Entra, em AuthentICATION > Redirect URIs, com o mesmo
# tipo de plataforma (Single-page application).
# Desenvolvimento local: http://localhost:5173
# Publicado no GitHub Pages: https://SEU-USUARIO.github.io/SEU-REPO/
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Supabase. A chave anon (sb_publishable_) e publica por natureza: ela vai
# embutida no bundle do navegador e o acesso aos dados e protegido por RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=